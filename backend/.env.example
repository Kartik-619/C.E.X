# ---- Runtime ----
# Use PostgreSQL instead of in-memory stores
USE_DB=true

# ---- PostgreSQL connection ----
# Option A: full connection string (takes precedence over the options below)
# Example: postgres://postgres:password@localhost:5432/cex
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cex

# Option B: individual connection fields (used only when DATABASE_URL is unset)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cex
# DB_USER=postgres
# DB_PASSWORD=postgres

# ---- Auth ----
JWT_SECRET=your-secret-key
FRONTEND_URL=http://localhost:3000
# OAUTH_PROVIDER=google,github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3010/api/auth/oauth/callback

# ---- Email / OTP ----
# EMAIL_SERVICE_ID=
# EMAIL_TEMPLATE_ID=
# EMAIL_PUBLIC_KEY=
# EMAIL_SERVICE_KEY=
# EMAIL_FROM_NAME=CEX Support