# ── Server ──────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key
USE_DB=false
FRONTEND_URL=http://localhost:3000

# ── Database (used when USE_DB=true) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cex
DB_USER=postgres
DB_PASSWORD=postgres

# ── OAuth ───────────────────────────────────────────────────────────
# Set the OAuth provider you want to enable: 'google' | 'github'
OAUTH_PROVIDER=

# OAuth redirect URI (back to the backend callback)
OAUTH_REDIRECT_URI=http://localhost:3010/api/auth/oauth/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
